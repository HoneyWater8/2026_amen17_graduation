# 졸업 간증 영상 URL
#
# 자체 호스팅 두 가지 방식 중 하나를 선택합니다.
#
#   1) 저장소에 직접 두기 — FE/public/video/testimony.mp4 로 넣고 이 값을 비워둡니다.
#      (기본 fallback 경로가 '/video/testimony.mp4' 입니다)
#      ※ 4분 세로 영상은 수십~수백 MB라 저장소·번들이 무거워집니다. 짧은 영상에만 권장.
#
#   2) Vercel Blob 사용 (권장) — 아래 순서로 업로드 후 반환된 공개 URL을 입력합니다.
#        vercel blob put ./testimony.mp4 --add-random-suffix=false
#      예: VITE_VIDEO_URL=https://xxxxxxxx.public.blob.vercel-storage.com/testimony.mp4
#
# 값이 비어 있고 public/video/testimony.mp4 도 없으면 placeholder 슬롯이 표시됩니다.
VITE_VIDEO_URL=

# 영상 포스터(첫 프레임) 이미지 — 선택. 비우면 검은 배경.
VITE_VIDEO_POSTER=

# ─────────────────────────────────────────────────────────
# 카카오톡 공유
#
# 카카오 개발자 콘솔(https://developers.kakao.com/)의 **JavaScript 키**.
#   내 애플리케이션 → 앱 설정 → 앱 키 → JavaScript 키
#
# ⚠️ 반드시 Web 플랫폼에 배포 도메인을 등록해야 동작합니다.
#   앱 설정 → 플랫폼 → Web → 사이트 도메인에 아래를 추가:
#     https://2026amen17graduation.vercel.app
#
# 공유 카드의 제목·설명·이미지는 이 키가 아니라 index.html의 og:* 태그가 결정합니다
# (sendScrap 방식). 카드를 바꾸려면 index.html을 고치세요.
#
# 키가 비어 있으면 카카오 SDK를 부르지 않고 navigator.share(네이티브 공유 시트)로
# 폴백합니다. 그것도 불가하면 링크 복사만 동작합니다.
VITE_KAKAO_JS_KEY=

# ─────────────────────────────────────────────────────────
# 배포 시
#   이 파일을 .env.local 로 복사해 로컬에서 사용하고,
#   배포용 값은 Vercel 대시보드(Settings → Environment Variables)에 등록합니다.
#   등록한 값을 로컬로 가져오려면: npx vercel env pull .env.local
#
#   현재 필수 환경 변수는 없습니다. 영상이 준비되기 전까지는
#   아무것도 등록하지 않아도 페이지가 정상 동작합니다(placeholder 표시).
# ─────────────────────────────────────────────────────────
