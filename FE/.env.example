# 초원별 간증 영상 10개 + 졸업 예배 감사 영상
#
# URL은 Vercel Blob 등의 공개 주소 또는 /video/파일명.mp4 경로를 사용합니다.
# 로컬 영상은 FE/public/video/ 아래에 두되, 이 디렉터리는 git 제외 대상입니다.
# 배포용 영상은 Vercel Blob의 공개 URL을 지정합니다.
# 2026-09-22: 간증 02·08·09·10과 감사 합본의 경량본 URL을 Production/Preview에 등록했습니다.
# 공개 URL 목록과 교체 절차는 ../docs/video-assets.md를 참고합니다.
# BLOB_READ_WRITE_TOKEN 등의 업로드 인증 값에는 VITE_ 접두사를 붙이지 않습니다.
#
# 초원 영상 URL이 비어 있으면 수령한 02·08·09·10은 /video/testimony/NN/preview.mp4를 사용합니다.
# 미수령 초원(01·03·04·05·06·07)이나 영상 로드 실패 시에는 준비 안내가 표시됩니다.
# 초원명과 표시 순서는 src/data/graduation.ts의 testimony.groups에서 수정합니다.

# 02 졸업 간증 영상 — 16:9 카드, 2열 × 5행. 포스터는 선택 사항입니다.
VITE_TESTIMONY_1_VIDEO_URL=
VITE_TESTIMONY_1_VIDEO_POSTER=
VITE_TESTIMONY_2_VIDEO_URL=
VITE_TESTIMONY_2_VIDEO_POSTER=
VITE_TESTIMONY_3_VIDEO_URL=
VITE_TESTIMONY_3_VIDEO_POSTER=
VITE_TESTIMONY_4_VIDEO_URL=
VITE_TESTIMONY_4_VIDEO_POSTER=
VITE_TESTIMONY_5_VIDEO_URL=
VITE_TESTIMONY_5_VIDEO_POSTER=
VITE_TESTIMONY_6_VIDEO_URL=
VITE_TESTIMONY_6_VIDEO_POSTER=
VITE_TESTIMONY_7_VIDEO_URL=
VITE_TESTIMONY_7_VIDEO_POSTER=
VITE_TESTIMONY_8_VIDEO_URL=
VITE_TESTIMONY_8_VIDEO_POSTER=
VITE_TESTIMONY_9_VIDEO_URL=
VITE_TESTIMONY_9_VIDEO_POSTER=
VITE_TESTIMONY_10_VIDEO_URL=
VITE_TESTIMONY_10_VIDEO_POSTER=

# 03 여정 · 졸업 예배 — 사진 캐러셀 아래에 표시할 감사 통합본
# URL이 비어 있으면 /video/graduation/preview.mp4를 사용합니다.
VITE_GRADUATION_VIDEO_URL=
VITE_GRADUATION_VIDEO_POSTER=

# ─────────────────────────────────────────────────────────
# 카카오톡 공유
#
# 카카오 개발자 콘솔(https://developers.kakao.com/)의 **JavaScript 키**.
#   내 애플리케이션 → 앱 설정 → 앱 키 → JavaScript 키
#
# ⚠️ 키만으로는 동작하지 않습니다. 콘솔에 배포 도메인을 등록해야 합니다.
#   [앱] → 제품 링크 관리 → 사이트 도메인:
#     https://2026amen17graduation.vercel.app
#
#   「앱 설정 → 플랫폼 → Web」에도 도메인 입력란이 있지만,
#   공유 기능이 보는 곳은 제품 링크 관리입니다.
#   빠지면 공유 시 4019(인증 실패) 오류가 납니다.
#   와일드카드 미지원 — 프리뷰 URL이나 localhost도 쓰려면 따로 등록.
#
# 공유 카드의 제목·설명·이미지는 이 키가 아니라 index.html의 og:* 태그가 결정합니다
# (sendScrap 방식). 카드를 바꾸려면 index.html을 고치세요.
#
# 키가 비어 있으면 카카오 SDK를 부르지 않고 navigator.share(네이티브 공유 시트)로
# 폴백합니다. 그것도 불가하면 링크 복사만 동작합니다.
VITE_KAKAO_JS_KEY=

# ─────────────────────────────────────────────────────────
# Google Analytics 4
#
# 측정 ID는 환경 변수가 아니라 index.html의 표준 스니펫에 직접 넣습니다.
# 모듈로 감싸 동적 로드했을 때 page_view가 `en` 파라미터 없이 나가
# GA가 이벤트를 인식하지 못하는 문제가 있었습니다 (2026-09-11).
# 측정 ID는 스크립트에 노출되는 공개 값이라 하드코딩해도 무방합니다.
#
# 바꾸려면 FE/index.html 의 gtag 스니펫 두 곳(script src, config)을 고치세요.

# ─────────────────────────────────────────────────────────
# 배포 시
#   이 파일을 .env.local 로 복사해 로컬에서 사용하고,
#   배포용 값은 Vercel 대시보드(Settings → Environment Variables)에 등록합니다.
#   등록한 값을 로컬로 가져오려면: npx vercel env pull .env.local
#
#   현재 필수 환경 변수는 없습니다. 영상이 준비되기 전까지는
#   아무것도 등록하지 않아도 페이지가 정상 동작합니다(placeholder 표시).
# ─────────────────────────────────────────────────────────
